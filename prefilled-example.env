###############################################################################
# AI-Stack — Prefilled Example Environment File
#
# THIS IS NOT A REAL .env FILE. Every credential/secret value below is
# randomly generated, fake data — committed to git purely to illustrate what
# a fully filled-out .env looks like (useful for onboarding, docs, and
# screenshots) without exposing this deployment's actual secrets.
#
# DO NOT use these values in any real deployment. Before use:
#   1. Copy this file to `.env` (or start from `.env.example` instead — that
#      is the canonical template with blank/changeme placeholders).
#   2. Regenerate every secret below, e.g.: openssl rand -hex 32
#
# See `.env.example` for the authoritative, documented template and
# CLAUDE.md Section 2 for the air-gap parameterization rules this file
# follows.
###############################################################################

# ---------------------------------------------------------------------------
# Registry / Air-Gap Sourcing
# ---------------------------------------------------------------------------
# Example: pointed at an internal mirror registry for a disconnected deployment.
REGISTRY_PREFIX=registry.internal.example.com:5000/

# ---------------------------------------------------------------------------
# Open WebUI — Frontend / UI
# ---------------------------------------------------------------------------
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui
OPEN_WEBUI_VERSION=v0.11.1
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=9f857a6c37887e9b631cb72aff639e51316c819ab26c36ef7ac1b3a151302e1

# ---------------------------------------------------------------------------
# vLLM — Inference Engine (chat/completions)
# ---------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai
VLLM_VERSION=v0.28.0
VLLM_PORT=8000

MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
MODEL_DIR=Qwen2.5-7B-Instruct-AWQ
SERVED_MODEL_NAME=qwen2.5-7b-instruct
VLLM_MAX_MODEL_LEN=24576
VLLM_DTYPE=auto
VLLM_TOOL_CALL_PARSER=hermes

VLLM_GPU_IDS=0
VLLM_GPU_MEMORY_UTILIZATION=0.35

# ---------------------------------------------------------------------------
# Embeddings — NVIDIA NeMo Retriever (served via vLLM in pooling/embed mode)
# ---------------------------------------------------------------------------
EMBEDDINGS_IMAGE=vllm/vllm-openai
EMBEDDINGS_VERSION=v0.28.0
EMBEDDINGS_PORT=8001

EMBEDDING_MODEL_NAME=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_MODEL_DIR=llama-nemotron-embed-1b-v2
EMBEDDING_SERVED_MODEL_NAME=llama-nemotron-embed-1b-v2
EMBEDDING_MAX_MODEL_LEN=4096

EMBEDDINGS_GPU_IDS=0
EMBEDDINGS_GPU_MEMORY_UTILIZATION=0.55
AUTOCOMPLETE_IMAGE=vllm/vllm-openai
AUTOCOMPLETE_VERSION=v0.28.0
AUTOCOMPLETE_PORT=8002
AUTOCOMPLETE_MODEL_NAME=TechxGenus/CodeGemma-7b-AWQ
AUTOCOMPLETE_MODEL_DIR=CodeGemma-7b-AWQ
AUTOCOMPLETE_SERVED_MODEL_NAME=codegemma-7b
AUTOCOMPLETE_MAX_MODEL_LEN=8192
AUTOCOMPLETE_GPU_IDS=0
AUTOCOMPLETE_GPU_MEMORY_UTILIZATION=0.30

# ---------------------------------------------------------------------------
# LiteLLM Proxy — Unified OpenAI-compatible API Gateway
# ---------------------------------------------------------------------------
LITELLM_IMAGE=ghcr.io/berriai/litellm
LITELLM_VERSION=v1.99.1
LITELLM_PORT=4000
LITELLM_MASTER_KEY=2970f66a1d2472836ccfab346e17e0a4cdda30089665c575cee2c47a251af02
LITELLM_SALT_KEY=430a2c643ef808d8cf316666001ca16d6c10f564a0a80c987eb26d16f02d337
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=6b28043f8267ce830d554d839ab3a94059e90d1a3b4ed69db51cf8153fcb985

# ---------------------------------------------------------------------------
# Postgres — LiteLLM's state store (Admin UI, virtual keys, budgets, spend
# tracking). LiteLLM self-migrates its schema on startup; no manual step.
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=litellm
POSTGRES_PASSWORD=5f0a1bcedc042c22bc0d7c015ff65294559aef2addf233cee0cf16a01180d10
POSTGRES_DB=litellm

# ---------------------------------------------------------------------------
# Qdrant — Vector Database
# ---------------------------------------------------------------------------
QDRANT_IMAGE=qdrant/qdrant
QDRANT_VERSION=v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Example API key — leave empty instead to disable API key auth (fine for a
# fully internal/air-gapped network).
QDRANT_API_KEY=a8b67274d5811f719da14eca9f5ac56b610463c0b11f6670bc1a36bf35cd5d2

# ---------------------------------------------------------------------------
# NGINX — Reverse Proxy / Ingress
# ---------------------------------------------------------------------------
NGINX_IMAGE=nginx
NGINX_VERSION=1.31.4-alpine
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
NGINX_SSL_CERT_PATH=./config/nginx/certs/server.crt
NGINX_SSL_KEY_PATH=./config/nginx/certs/server.key
NGINX_CLIENT_MAX_BODY_SIZE=100M

# ---------------------------------------------------------------------------
# Storage Paths (host bind mounts)
# ---------------------------------------------------------------------------
LOCAL_MODELS_DIR=./models

# ---------------------------------------------------------------------------
# Offline / Air-Gap Enforcement (mandatory — do not unset on disconnected hosts)
# ---------------------------------------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# ---------------------------------------------------------------------------
# FIPS host / Ubuntu-base-image workaround (vllm + embeddings only)
# ---------------------------------------------------------------------------
FIPS_OVERRIDE_FILE=./config/fips-workaround/fips_enabled_override

# ---------------------------------------------------------------------------
# scripts/ingest_git_repo.py — bulk-ingest a git repo into Open WebUI's RAG
# ---------------------------------------------------------------------------
GITLAB_REPO_URL=https://gitlab.example.com/group/example-project.git
GITLAB_ACCESS_TOKEN=FAKE-EXAMPLE-GITLAB-TOKEN-DO-NOT-USE-00000000
GITLAB_BRANCH=main
OPEN_WEBUI_API_KEY=FAKE-EXAMPLE-OPENWEBUI-API-KEY-DO-NOT-USE-00000000
INGEST_KNOWLEDGE_NAME=example-project-docs
INGEST_MAX_FILE_SIZE_KB=1024

# ---------------------------------------------------------------------------
# scripts/ingest_mediawiki.py — bulk-ingest a MediaWiki instance into Open WebUI's RAG
# ---------------------------------------------------------------------------
MEDIAWIKI_BASE_URL=http://wiki.example.com
MEDIAWIKI_USERNAME=example-bot@example-bagname
MEDIAWIKI_PASSWORD=FAKE-EXAMPLE-MEDIAWIKI-PASSWORD-DO-NOT-USE-00000000
MEDIAWIKI_NAMESPACES=0
MEDIAWIKI_KNOWLEDGE_NAME=example-wiki-docs
