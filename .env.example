###############################################################################
# AI-Stack — Master Environment Template
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up -d`. Never commit `.env` — only this template.
#
# Per CLAUDE.md Section 2: docker-compose.yml must never contain a hardcoded
# image tag, port, path, GPU id, model name, or credential. Every one of
# those lives here. When you add a new container/parameter to the stack,
# add its variable here too, with a comment.
###############################################################################

# ---------------------------------------------------------------------------
# Registry / Air-Gap Sourcing
# ---------------------------------------------------------------------------
# Prefix prepended to every image name below. Point this at your internal
# mirror registry when operating disconnected, e.g. "registry.internal.example.com:5000/".
# Leave empty to pull from the public registries named below (connected/staging side only).
REGISTRY_PREFIX=

# ---------------------------------------------------------------------------
# Open WebUI — Frontend / UI
# ---------------------------------------------------------------------------
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui
OPEN_WEBUI_VERSION=v0.11.1
OPEN_WEBUI_PORT=3000
# Long random secret used to sign Open WebUI session tokens. Generate with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=changeme-generate-a-long-random-string

# ---------------------------------------------------------------------------
# vLLM — Inference Engine (chat/completions)
# ---------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai
VLLM_VERSION=v0.28.0
VLLM_PORT=8000

# HF repo id, used only as a human-readable label and by scripts/download_models.sh.
# Ungated — downloads with no HF account/token required. 4-bit AWQ quantized:
# ~7B params in ~5GB, chosen over full fp16 (~15GB) so it comfortably shares
# this test box's single GPU with the embeddings service. On the eventual
# multi-GPU production host, a full-precision 7B+ on its own dedicated GPU is
# a reasonable upgrade — quantization here is a test-box VRAM concession, not
# an architectural requirement. Chosen over the smaller Qwen2.5-3B-Instruct for
# meaningfully more reliable tool/function-calling (see README's model-size
# tradeoffs note) — small models are prone to malformed tool calls (e.g.
# dropping required arguments) that larger ones handle much more reliably.
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
# Subdirectory under LOCAL_MODELS_DIR where the weights are staged on disk.
MODEL_DIR=Qwen2.5-7B-Instruct-AWQ
# Name clients (Open WebUI, LiteLLM, direct API callers) request this model as.
SERVED_MODEL_NAME=qwen2.5-7b-instruct
VLLM_MAX_MODEL_LEN=24576
VLLM_DTYPE=auto
# No explicit --quantization flag needed: vLLM auto-detects it from the
# model's own quantization_config in config.json when the flag is omitted,
# which keeps docker-compose.yml working unmodified for quantized and
# full-precision models alike.
# Required for Open WebUI (and any client sending tool_choice="auto") to work —
# without --enable-auto-tool-choice + a matching --tool-call-parser, vLLM 400s
# on any request with tool_choice=auto with "'auto' tool choice requires
# --enable-auto-tool-choice and --tool-call-parser to be set". `hermes` is the
# correct parser for the Qwen2.5-Instruct family; changing MODEL_NAME to a
# different model family usually means changing this too (see vLLM's
# --tool-call-parser choices, e.g. llama3_json for Llama, mistral for Mistral).
VLLM_TOOL_CALL_PARSER=hermes

# GPU(s) this container may see, as a comma-separated list of device indices
# (matches `nvidia-smi -L` ordering), e.g. "0" or "0,1". Requires the host's
# NVIDIA Container Toolkit to expose the legacy `nvidia` runtime.
VLLM_GPU_IDS=0
# Fraction of the *selected* GPU(s) total memory vLLM is allowed to reserve.
# NOTE: this test box shares one 3090 between vllm and embeddings, so this is
# tuned low (0.35). On a production host where each service gets its own
# dedicated GPU(s), raise this toward 0.85-0.90 for better KV-cache headroom.
VLLM_GPU_MEMORY_UTILIZATION=0.35

# ---------------------------------------------------------------------------
# Embeddings — NVIDIA NeMo Retriever (served via vLLM in pooling/embed mode)
# ---------------------------------------------------------------------------
# NOTE: NV-Embed-v2's custom `NVEmbedModel` architecture is NOT in vLLM's
# supported-architectures list as of v0.28.0 (dropped upstream) — it will
# fail to load with a pydantic ValidationError. llama-nemotron-embed-1b-v2
# is NVIDIA's maintained NeMo Retriever-family successor: architecture
# `LlamaBidirectionalModel`, which vLLM does support natively. Also ungated
# and far lighter (~1B params) than NV-Embed-v2's 7.8B, which helps on a
# GPU shared with vllm.
EMBEDDINGS_IMAGE=vllm/vllm-openai
EMBEDDINGS_VERSION=v0.28.0
EMBEDDINGS_PORT=8001

EMBEDDING_MODEL_NAME=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_MODEL_DIR=llama-nemotron-embed-1b-v2
EMBEDDING_SERVED_MODEL_NAME=llama-nemotron-embed-1b-v2
EMBEDDING_MAX_MODEL_LEN=4096

EMBEDDINGS_GPU_IDS=0
# See VLLM_GPU_MEMORY_UTILIZATION note above re: sharing GPU 0 on this test box.
EMBEDDINGS_GPU_MEMORY_UTILIZATION=0.55

# ---------------------------------------------------------------------------
# Autocomplete — code-completion inference engine (VSCode/Continue-style FIM),
# served via vLLM. OPTIONAL: this service only starts when the "autocomplete"
# Compose profile is enabled (`docker compose --profile autocomplete up -d`,
# or set COMPOSE_PROFILES=autocomplete below) — it does NOT start with a bare
# `docker compose up -d`. This model needs ~16GB of VRAM on its own (see
# below) — a dedicated/second GPU, not this test box's single shared 3090.
#
# Model history — two rejected before landing on this one, each verified
# live rather than assumed:
#   1. Gemma 4 E4B: an open, unresolved report that its tokenizer_config.json
#      is missing FIM special tokens entirely
#      (https://huggingface.co/google/gemma-4-E4B/discussions/3).
#   2. TechxGenus/CodeGemma-7b-AWQ (a third-party AWQ quant of Google's
#      CodeGemma, chosen next since CodeGemma IS genuinely FIM-pretrained):
#      loaded and served fine, but a live /v1/completions test showed the
#      model treating `<|fim_prefix|>` etc. as literal text rather than
#      control tokens — confirmed via /tokenize that this specific AWQ
#      repackaging fragments each FIM marker into 7 sub-word tokens instead
#      of one atomic special token. A real packaging defect in that repo,
#      not a config mistake on our end.
#   3. ibm-granite/granite-3.3-8b-base: WORKING, verified live. /tokenize
#      confirms `<fim_prefix>`/`<fim_middle>`/`<fim_suffix>` are atomic
#      tokens at their documented IDs (1/2/3), and real completions are
#      correct, e.g. prefix "return n * ", suffix "\n\nprint(factorial(5))"
#      -> generates exactly "factorial(n-1)", stopping cleanly (not
#      truncated). IBM's own docs note FIM support was added in the 3.3
#      generation specifically — granite-3.1-8b-base has the same tokens
#      present in its vocab (inherited reserved IDs) but did NOT produce
#      correct completions in the same live test, so don't downgrade to 3.1
#      assuming the tokens alone are enough.
#
# No quantized version of the BASE model exists yet from a reputable source
# (RedHatAI/Neural Magic have only quantized granite-3.3-*-instruct, and
# -instruct is the wrong variant for raw FIM completion) — full bf16 is
# ~16GB of weights alone. Architecture GraniteForCausalLM, natively
# vLLM-supported (github.com/vllm-project/vllm has a dedicated module for
# it), ungated (unlike CodeGemma's original, no HF token needed).
AUTOCOMPLETE_IMAGE=vllm/vllm-openai
AUTOCOMPLETE_VERSION=v0.28.0
AUTOCOMPLETE_PORT=8002

AUTOCOMPLETE_MODEL_NAME=ibm-granite/granite-3.3-8b-base
AUTOCOMPLETE_MODEL_DIR=granite-3.3-8b-base
AUTOCOMPLETE_SERVED_MODEL_NAME=granite-3.3-8b-base
# 131072 (128K) is this model's actual max_position_embeddings, but FIM
# completions don't need anywhere near that much context — 4096 verified
# working live and keeps the KV cache budget modest. Raise it if your editor
# setup wants more surrounding-code context and your GPU has room.
AUTOCOMPLETE_MAX_MODEL_LEN=4096
# No --enable-auto-tool-choice/--tool-call-parser here (unlike vllm above):
# FIM completion is a raw /v1/completions call, not chat/tool-calling — see
# README's "VSCode autocomplete" section for the exact prompt format
# (<fim_prefix>/<fim_suffix>/<fim_middle> — single angle brackets, unlike
# CodeGemma's pipe-delimited <|fim_prefix|> style) and a Continue config
# example.

AUTOCOMPLETE_GPU_IDS=0
# Left unset by default (invalid on its own — vLLM requires a value >0) as a
# deliberate guard: if you enable the "autocomplete" profile without also
# setting this, vLLM's own error message will tell you rather than silently
# fighting vllm/embeddings for VRAM they've already claimed. This model needs
# roughly 16GB of weights alone at full precision, so realistically this
# means a dedicated/second GPU, not sharing GPU 0 with vllm/embeddings on a
# single-GPU host — 0.85+ on its own dedicated GPU is a reasonable starting
# point.
AUTOCOMPLETE_GPU_MEMORY_UTILIZATION=
# Uncomment to start the autocomplete service automatically with a bare
# `docker compose up -d`, once the above is actually configured for your
# host's available VRAM:
# COMPOSE_PROFILES=autocomplete

# ---------------------------------------------------------------------------
# LiteLLM Proxy — Unified OpenAI-compatible API Gateway
# ---------------------------------------------------------------------------
LITELLM_IMAGE=ghcr.io/berriai/litellm
LITELLM_VERSION=v1.83.14-stable
LITELLM_PORT=4000
# Required by LiteLLM for /key and admin endpoints. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=changeme-generate-a-long-random-string
# Salt key used to encrypt stored provider credentials in LiteLLM's DB (if enabled).
LITELLM_SALT_KEY=changeme-generate-a-long-random-string
# Admin UI login (http://localhost:${LITELLM_PORT}/ui). Deliberately separate
# from LITELLM_MASTER_KEY — that key is an all-powerful API credential and
# handing it out as a login password is worse hygiene than a dedicated one.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=changeme-generate-a-long-random-string

# ---------------------------------------------------------------------------
# Postgres — LiteLLM's state store (Admin UI, virtual keys, budgets, spend
# tracking). LiteLLM self-migrates its schema on startup; no manual step.
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme-generate-a-long-random-string
POSTGRES_DB=litellm

# ---------------------------------------------------------------------------
# Qdrant — Vector Database
# ---------------------------------------------------------------------------
QDRANT_IMAGE=qdrant/qdrant
QDRANT_VERSION=v1.19.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Leave empty to disable API key auth (fine for a fully internal/air-gapped network).
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# NGINX — Reverse Proxy / Ingress
# ---------------------------------------------------------------------------
NGINX_IMAGE=nginx
NGINX_VERSION=1.31.4-alpine
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# Paths (relative to repo root) to the TLS cert/key nginx terminates SSL with.
# Air-gapped hosts can't use ACME/Let's Encrypt — generate a self-signed pair with
# scripts/generate_self_signed_cert.sh, or drop in a cert issued by your internal CA.
NGINX_SSL_CERT_PATH=./config/nginx/certs/server.crt
NGINX_SSL_KEY_PATH=./config/nginx/certs/server.key
# Max request body size — needs headroom for large model prompts / file
# uploads through Open WebUI (e.g. RAG source documents). Nginx syntax:
# a bare number is bytes, or suffix with k/m/g (case-insensitive).
NGINX_CLIENT_MAX_BODY_SIZE=100M

# ---------------------------------------------------------------------------
# Storage Paths (host bind mounts)
# ---------------------------------------------------------------------------
# Root directory holding all pre-staged, offline model weights (see
# scripts/download_models.sh). Every *_MODEL_DIR above lives under here.
LOCAL_MODELS_DIR=./models

# ---------------------------------------------------------------------------
# Offline / Air-Gap Enforcement (mandatory — do not unset on disconnected hosts)
# ---------------------------------------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# ---------------------------------------------------------------------------
# FIPS host / Ubuntu-base-image workaround (vllm + embeddings only)
# ---------------------------------------------------------------------------
# On a host with kernel FIPS mode enabled (/proc/sys/crypto/fips_enabled=1 —
# common on RHEL/Rocky with a FIPS:STIG crypto policy), Ubuntu's patched
# OpenSSL 3.0.x inside the vllm/vllm-openai image auto-detects that kernel
# flag and tries to enter FIPS mode, then crashes immediately (before model
# load — it's hit at aiohttp import time) because the image ships no FIPS
# provider module. Bind-mounting a file containing "0" over
# /proc/sys/crypto/fips_enabled inside just these two containers works
# around it without touching the host's real FIPS setting or nginx's TLS
# termination. COMPLIANCE NOTE: this masks that one Ubuntu auto-detect
# check inside vllm/embeddings — confirm with your security/compliance team
# before relying on this in a FIPS-mandated production deployment; on a
# non-FIPS host this mount is a harmless no-op (the flag already reads 0).
FIPS_OVERRIDE_FILE=./config/fips-workaround/fips_enabled_override

# ---------------------------------------------------------------------------
# scripts/ingest_git_repo.py — bulk-ingest a git repo into Open WebUI's RAG
# ---------------------------------------------------------------------------
# All optional: every one of these has a --flag CLI override too (see --help).
# GitLab source (leave blank and use --repo-url/--local-path per-invocation
# instead, if you'd rather not put a token at rest in .env).
GITLAB_REPO_URL=
# Personal or project access token with at least read_repository scope.
GITLAB_ACCESS_TOKEN=
GITLAB_BRANCH=
# Open WebUI: Settings -> Account -> API Keys -> create one. Required unless
# you only ever run with --dry-run.
OPEN_WEBUI_API_KEY=
# Knowledge base name to create/reuse. Blank = derived from the repo name
# (+ commit short SHA when cloning, for natural per-run uniqueness).
INGEST_KNOWLEDGE_NAME=
# Shared by both ingest_git_repo.py and ingest_mediawiki.py.
INGEST_MAX_FILE_SIZE_KB=1024

# ---------------------------------------------------------------------------
# scripts/ingest_mediawiki.py — bulk-ingest a MediaWiki instance into Open WebUI's RAG
# ---------------------------------------------------------------------------
# All optional: every one of these has a --flag CLI override too (see --help).
# Base URL only (script appends /api.php) — e.g. http://192.168.10.91.
MEDIAWIKI_BASE_URL=
# Always authenticates via the Action API's clientlogin flow (not the
# GITLAB_ACCESS_TOKEN-style header approach above — MediaWiki's API has no
# equivalent). A regular account works, but a Special:BotPasswords
# username (looks like AdminName@bagname) + generated password, scoped to
# just the rights this needs, is better practice than using a real login.
MEDIAWIKI_USERNAME=
MEDIAWIKI_PASSWORD=
# Comma-separated namespace IDs to ingest, e.g. "0,4" for Main + Project.
# Blank = just 0 (Main) — deliberately excludes Talk/User/Special/etc unless
# asked for.
MEDIAWIKI_NAMESPACES=
# Knowledge base name to create/reuse. Blank = derived from the wiki's own
# sitename (MediaWiki has no single "revision" concept like a git commit SHA
# to make this naturally unique per run, unlike ingest_git_repo.py's default).
MEDIAWIKI_KNOWLEDGE_NAME=
