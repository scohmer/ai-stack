# AI-Stack — service routing (TEMPLATE)
#
# This is rendered by the STOCK nginx image's own built-in entrypoint script
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) — any *.template file
# under /etc/nginx/templates/ gets `envsubst`'d into /etc/nginx/conf.d/ at
# container start, substituting ${VAR} from whatever's in the container's
# environment (docker-compose's `environment:` list on the nginx service).
# No custom wrapper needed; this is a standard, documented nginx image
# feature. Only variables actually present in the container's environment
# get substituted, so nginx's own `$host`/`$scheme`/etc. runtime variables
# below are left untouched (they're not among the container's env vars).
#
# / (root)    -> Open WebUI (chat frontend), WebSocket-aware
# /litellm/   -> LiteLLM Proxy (unified OpenAI-compatible gateway), prefix stripped
# /vectors/   -> Qdrant HTTP API, for internal/admin debugging only
#
# NOTE: LiteLLM is intentionally NOT mounted at /api/ — Open WebUI's own
# frontend calls its own backend at /api/... on the same origin (e.g.
# /api/config), so an /api/ location here would hijack those calls and the
# SPA would show "Open WebUI Backend Required" with a working-looking
# frontend and an unreachable backend. Use /litellm/ for direct external API
# access to the gateway instead.
#
# TLS cert/key paths are bind-mounted by docker-compose from
# NGINX_SSL_CERT_PATH / NGINX_SSL_KEY_PATH in .env. Air-gapped hosts can't
# use ACME — generate a self-signed pair with scripts/generate_self_signed_cert.sh
# or drop in one issued by your internal CA.

upstream open_webui_upstream {
    server open-webui:8080;
}

upstream litellm_upstream {
    server litellm:4000;
}

upstream qdrant_upstream {
    server qdrant:6333;
}

# Plain HTTP: redirect everything to HTTPS.
# $host already carries whatever host:port the client used to reach us, so
# NGINX_HTTPS_PORT doesn't need to be interpolated into this redirect target
# even though templating now makes that possible.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Needed for large model prompts / file uploads through Open WebUI.
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location / {
        proxy_pass http://open_webui_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /litellm/ {
        rewrite ^/litellm/(.*)$ /$1 break;
        proxy_pass http://litellm_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /vectors/ {
        rewrite ^/vectors/(.*)$ /$1 break;
        proxy_pass http://qdrant_upstream;
        proxy_set_header Host $host;
    }
}
